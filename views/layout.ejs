<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' — ' : '' %>Catálogo Tom Hanks</title>
  <meta name="description" content="Catálogo de filmes com Tom Hanks. Favorite e comente seus filmes preferidos.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <% if (usuario) { %>
  <header class="site-header">
    <div class="header-inner">
      <a href="/catalog" class="logo">🎬 Tom Hanks</a>
      <nav class="header-nav">
        <a href="/catalog">Catálogo</a>
        <a href="/user/favorites">Meus Favoritos</a>
        <span class="usuario-nome">👤 <%= usuario.nome %></span>
        <a href="/auth/logout" class="btn-logout">Sair</a>
      </nav>
    </div>
  </header>
  <% } %>

  <main class="main-content">
    <%- body %>
  </main>

  <footer class="site-footer">
    <p>ISW055 · Atividade 02 &mdash; Dados fornecidos por <a href="https://www.themoviedb.org" target="_blank">TMDB</a></p>
  </footer>
</body>
</html>
